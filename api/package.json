{
  "name": "@vigia/api",
  "version": "0.1.0",
  "private": true,
  "description": "Vigía de Contrataciones · API: datos y reglas de dominio para los robots UiPath y el dashboard",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/scripts/seed.ts",
    "esquema:exportar": "tsx src/scripts/exportar-esquema.ts",
    "ocds:cargar": "tsx src/scripts/ocds.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.6",
    "@fastify/multipart": "^10.1.6",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
