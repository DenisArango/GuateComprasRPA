# Variables de la API, el dashboard y la base de datos (Docker Compose).
# La configuración de los robots (pausas, SMTP, Telegram, clave de IA, etc.)
# vive en los assets de Orchestrator; ver docs/08-diseno-del-bot.md#810-configuración.

# Base de datos
DATABASE_URL=postgresql://vigia:vigia@localhost:5433/vigia

# API
JWT_SECRET=
# Clave que usan los robots para las rutas /robot/* (la misma va en el asset VC_ApiClave)
ROBOT_API_CLAVE=

# IA: la API lleva el control del presupuesto; en producción la clave de Claude está en el asset VC_IA.
# ANTHROPIC_API_KEY solo para pruebas locales de la extracción.
ANTHROPIC_API_KEY=
IA_PRESUPUESTO_DIARIO_USD=2.00
FICHA_UMBRAL_CONFIANZA=0.7

# UiPath Orchestrator (External Application con credenciales de cliente)
UIPATH_URL=https://cloud.uipath.com
UIPATH_ORG=
UIPATH_TENANT=DefaultTenant
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
UIPATH_SCOPES="OR.Folders OR.Queues OR.Assets OR.Jobs OR.Execution OR.Robots OR.Machines OR.Settings.Read OR.Monitoring"
UIPATH_FOLDER=Shared

# Correo del proyecto: envía notificaciones (SMTP) y recibe el boletín diario (IMAP).
# Gmail: activar verificación en dos pasos y usar una "contraseña de aplicación" (16 letras, sin espacios).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Dirección del dashboard para los enlaces de los correos
WEB_URL=http://localhost:4200
# A quién avisan los robots cuando algo falla
CORREO_ADMIN=
# Opcional
TELEGRAM_BOT_TOKEN=

# Usuario de Orchestrator (correo) que recibe asignadas las tareas de validación de fichas en Action Center
REVISOR_FICHAS=
