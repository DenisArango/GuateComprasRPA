    <upaf:GetFormTasks DisplayName="Get Form Tasks · completadas" Filter="[&quot;Status eq 'Completed'&quot;]" OrderBy="[&quot;LastModificationTime desc&quot;]" sap2010:WorkflowViewState.IdRef="GetFormTasks_1" TaskCatalogName="[in_CatalogoTareas]" TaskObjects="[tareas]" Top="[CType(in_Maximo, Nullable(Of Int32))]" />
    <ui:ForEach x:TypeArguments="upaf:FormTaskData" CurrentIndex="{x:Null}" DisplayName="Por cada tarea completada" sap2010:WorkflowViewState.IdRef="ForEach_1" Values="[tareas]">
      <ui:ForEach.Body>
