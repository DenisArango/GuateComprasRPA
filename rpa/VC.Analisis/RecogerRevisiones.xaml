          <InArgument x:TypeArguments="x:String" x:Key="accion">[If(datosTarea.Action Is Nothing, &quot;&quot;, datosTarea.Action)]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="datosJson">[If(datosTarea.Data Is Nothing, &quot;{}&quot;, Newtonsoft.Json.JsonConvert.SerializeObject(datosTarea.Data))]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="apiUrl">[apiUrl]</InArgument>
          <OutArgument x:TypeArguments="x:Boolean" x:Key="procesada">[procesada]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="nog">[nog]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="resultado">[resultado]</OutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
          <If Condition="[procesada]" DisplayName="¿Se guardó? → notificar la ficha" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_1">
