  </TextExpression.ReferencesForImplementation>
  <Sequence sap2010:Annotation.AnnotationText="Lee el texto digital de un PDF página por página (Read PDF Text con Range = número de página), para conservar la referencia de página que exige RNF-14. Las páginas escaneadas devuelven poco o ningún texto: GuardarTexto.cs marca el documento como escaneado y la IA lo recibe como PDF." DisplayName="LeerTextoPdf" sap2010:WorkflowViewState.IdRef="Sequence_100">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="paginas" />
      <Variable x:TypeArguments="x:String" Name="texto" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <updf:GetPDFPageCount DisplayName="Contar páginas del PDF" FileName="[in_Ruta]" PageCount="[paginas]" sap2010:WorkflowViewState.IdRef="GetPDFPageCount_1" />
    <Assign DisplayName="Iniciar texto por página" sap2010:WorkflowViewState.IdRef="Assign_1">
          <Assign.To><OutArgument x:TypeArguments="scg:Dictionary(x:Int32, x:String)">[out_TextoPorPagina]</OutArgument></Assign.To>
          <Assign.Value><InArgument x:TypeArguments="scg:Dictionary(x:Int32, x:String)">[New Dictionary(Of Int32, String)]</InArgument></Assign.Value>
        </Assign>
    <ui:ForEach x:TypeArguments="x:Int32" CurrentIndex="{x:Null}" DisplayName="Por cada página" sap2010:WorkflowViewState.IdRef="ForEach_1" Values="[Enumerable.Range(1, paginas)]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:Int32">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Int32" Name="pagina" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Cuerpo" sap2010:WorkflowViewState.IdRef="Sequence_1">
          <upa:ReadPDFText DisplayName="Read PDF Text (una página)" FileName="[in_Ruta]" Range="[pagina.ToString]" Text="[texto]" sap2010:WorkflowViewState.IdRef="ReadPDFText_1" />
          <Assign DisplayName="Guardar texto de la página" sap2010:WorkflowViewState.IdRef="Assign_2">
          <Assign.To><OutArgument x:TypeArguments="x:String">[out_TextoPorPagina(pagina)]</OutArgument></Assign.To>
          <Assign.Value><InArgument x:TypeArguments="x:String">[texto]</InArgument></Assign.Value>
        </Assign>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:LogMessage DisplayName="Log · páginas leídas" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;PDF &quot; &amp; Path.GetFileName(in_Ruta) &amp; &quot;: &quot; &amp; paginas.ToString &amp; &quot; páginas leídas&quot;]" />
  </Sequence>
</Activity>
