<Activity mc:Ignorable="sap sap2010" x:Class="Main" this:Main.in_Nog="" this:Main.in_PerfilId="0" this:Main.in_Desatendido="False" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:uc="clr-namespace:UiPath.Core;assembly=UiPath.System.Activities" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:this="clr-namespace:" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property sap2010:Annotation.AnnotationText="NOG del concurso. Vacío: el robot lo pregunta." Name="in_Nog" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Perfil de la empresa. 0: el único perfil activo." Name="in_PerfilId" Type="InArgument(x:Int32)" />
    <x:Property sap2010:Annotation.AnnotationText="True cuando lo inicia la API al marcar Participaré: sin ventanas ni preguntas; actualiza la carpeta existente." Name="in_Desatendido" Type="InArgument(x:Boolean)" />
  </x:Members>
